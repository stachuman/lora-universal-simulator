      "model": "log_distance",
      "alpha": 3.0,
      "sigma_db": 1.0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 14.0,
      "node_tx_offset_sigma_db": 1.0,
      "node_rx_offset_sigma_db": 1.0,
      "asymmetry_coherence_ms": 60000
    }
  },
