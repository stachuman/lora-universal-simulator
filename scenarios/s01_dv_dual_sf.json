{
  "_name": "s01_dv_dual_sf",
  "_desc": "Distance-vector routing on SF7; data on SF12 via per-hop dual-SF dance. 15-node random mesh in a 5x5 km area (Barcelona-ish), deterministic path-loss. SF7 reach ~2.42 km / SF12 reach ~6.31 km at alpha=3. SF7-routing diameter is 4 hops; primary send n05 -> n13 (6.13 km, 4 hops); concurrent send n06 -> n15 (5.07 km, 4 hops) deliberately overlaps to stress concurrent-flight handling — the protocol's known failure mode and the next iteration target.",
  "simulation": {
    "duration_ms": 60000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 500,
    "radio": { "sf": 8, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance",
      "alpha": 3.0,
      "sigma_db": 0.0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 14.0
    }
  },
  "nodes": [
    { "name": "n01", "script": "scenarios/dv_dual_sf.lua", "config": { "routing_sf": 8, "allowed_data_sfs": [6,7,9], "beacon_period_ms": 5000 }, "lat": 41.3835, "lon": 2.1809 },
    { "name": "n02", "script": "scenarios/dv_dual_sf.lua", "config": { "routing_sf": 8, "allowed_data_sfs": [6,7,9], "beacon_period_ms": 5000 }, "lat": 41.4119, "lon": 2.1453 },
