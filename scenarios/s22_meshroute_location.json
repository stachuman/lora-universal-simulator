{
  "_name": "s22_meshroute_location",
  "_desc": "MeshRoute C++ firmware (FirmwareNode) DM LOCATION piggyback (spec 2026-06-14): alice (loc_in_dm ON, lat 52.30 / lon 13.405) sends a same-layer DM to bob. bob delivers the text AND emits a peer_location telemetry carrying alice's quantized coords (~11 m) — proving the opt-in location reaches the DM recipient. The toggle-off and (0,0) negatives + the exact ~11 m round-trip bound are covered by the native suite (test_node_r3 / test_frame_codec). M-frame (channel) location is DEFERRED.",
  "simulation": {
    "duration_ms": 120000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 125, "cr": 5, "duty_cycle": 10 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "engine": "meshroute", "key_hash32": "0xA11CE001",
      "config": { "leaf_id": 0, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000,
                  "quiet_threshold_ms": 0, "lbt_enabled": false,
                  "loc_in_dm": true, "lat_e7": 523000000, "lon_e7": 134050000 } },
    { "name": "bob", "node_id": 2, "engine": "meshroute", "key_hash32": "0xB0B00002",
      "config": { "leaf_id": 0, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000,
                  "quiet_threshold_ms": 0, "lbt_enabled": false } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 24.0, "rssi": -66.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 70000, "node": "alice", "command": "send 2 loc-from-alice" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "bob", "emit_type": "push",          "value": "loc-from-alice" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "peer_location", "value": "5230000" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "peer_location", "value": "13404" }
  ]
}
