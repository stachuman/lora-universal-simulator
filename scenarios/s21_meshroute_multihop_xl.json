{
  "_name": "s21_meshroute_multihop_xl",
  "_desc": "MeshRoute C++ firmware MULTI-HOP cross-layer DM: X (layer 4) is TWO hops from the gateway G via relay R, and X NEVER hears G's beacon. X can only originate because R re-gossips G's bridged-layer (type-4 TLV) so X learns 'G bridges leaf 5' multi-hop, plus a DV route to G. The schedule-fit happens at R (G's direct neighbor), NOT at X. Proves the 2026-06-14 multi-hop gateway discovery fix (was 0 delivery: select_gateway_for_leaf was 1-hop only).",
  "simulation": {
    "duration_ms": 160000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 125, "cr": 5, "duty_cycle": 10 }
  },
  "nodes": [
    { "name": "gw", "node_id": 10, "engine": "meshroute", "key_hash32": "0x44000010",
      "config": {
        "n_layers": 2,
        "layers": [
          { "layer_id": 4, "node_id": 10, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "window_period_ms": 15000, "window_ms": 2500, "window_offset_ms": 0 },
          { "layer_id": 5, "node_id": 11, "routing_sf": 8, "allowed_data_sfs": [11], "beacon_period_ms": 8000, "window_period_ms": 15000, "window_ms": 12500, "window_offset_ms": 2500 }
        ],
        "quiet_threshold_ms": 0, "lbt_enabled": false
      } },
    { "name": "r_l4", "node_id": 2, "engine": "meshroute", "key_hash32": "0x44000002",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } },
    { "name": "x_l4", "node_id": 1, "engine": "meshroute", "key_hash32": "0x44000001",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } },
    { "name": "y_l5", "node_id": 101, "engine": "meshroute", "key_hash32": "0x55000065",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [11], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } }
  ],
  "topology": {
    "links": [
      { "from": "x_l4", "to": "r_l4", "snr": 24.0, "rssi": -66.0, "bidir": true },
      { "from": "r_l4", "to": "gw",   "snr": 24.0, "rssi": -66.0, "bidir": true },
      { "from": "y_l5", "to": "gw",   "snr": 24.0, "rssi": -66.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 90000,  "node": "x_l4", "command": "send_layer 5 1426063461 multihop-l4-to-l5-via-relay" },
    { "at_ms": 96000,  "node": "x_l4", "command": "send_layer 5 1426063461 multihop-l4-to-l5-via-relay" },
    { "at_ms": 102000, "node": "x_l4", "command": "send_layer 5 1426063461 multihop-l4-to-l5-via-relay" },
    { "at_ms": 108000, "node": "x_l4", "command": "send_layer 5 1426063461 multihop-l4-to-l5-via-relay" }
  ],
  "expect": [
    { "type": "script_emit_contains",     "node": "y_l5", "emit_type": "push", "value": "multihop-l4-to-l5-via-relay" },
    { "type": "script_emit_contains",     "node": "r_l4", "emit_type": "tx_gateway_schedule_defer", "value": "" },
    { "type": "script_emit_not_contains", "node": "x_l4", "emit_type": "tx_gateway_schedule_defer", "value": "" }
  ]
}
