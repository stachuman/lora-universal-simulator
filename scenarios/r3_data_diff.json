    { "name": "bob",   "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 5000, "quiet_threshold_ms": 0, "peer_count": 1 },
      "lat": 41.4035, "lon": 2.1600 }
  ],
  "topology": { "links": [] },
  "commands": [ { "at_ms": 20000, "node": "alice", "command": "send bob hello-bob" } ],
  "expect": []
