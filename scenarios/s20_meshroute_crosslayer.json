{
  "_name": "s20_meshroute_crosslayer",
  "_desc": "MeshRoute C++ firmware (FirmwareNode) cross-layer DM end-to-end: a dual-layer gateway G (layers 4+5, one radio time-multiplexed) bridges a DM from X (layer 4) to Y (layer 5). X has NO direct link to Y — delivery requires the gateway bridge (Slice 4c.1). Also asserts the channel leak-gate: a layer-4 channel message never reaches layer 5 (the n_layers==2 gateway skips the gossip plane, Principle 11).",
  "simulation": {
    "duration_ms": 150000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 125, "cr": 5, "duty_cycle": 10 }
  },
  "nodes": [
    { "name": "gw", "node_id": 10, "engine": "meshroute", "key_hash32": "0x44000010",
      "config": {
        "n_layers": 2,
        "layers": [
          { "layer_id": 4, "node_id": 10, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "window_period_ms": 15000 },
          { "layer_id": 5, "node_id": 11, "routing_sf": 8, "allowed_data_sfs": [11], "beacon_period_ms": 8000, "window_period_ms": 15000 }
        ],
        "quiet_threshold_ms": 0, "lbt_enabled": false
      } },
    { "name": "x_l4", "node_id": 1, "engine": "meshroute", "key_hash32": "0x44000001",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } },
    { "name": "x2_l4", "node_id": 2, "engine": "meshroute", "key_hash32": "0x44000002",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [10], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } },
    { "name": "y_l5", "node_id": 101, "engine": "meshroute", "key_hash32": "0x55000065",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [11], "beacon_period_ms": 8000, "quiet_threshold_ms": 0, "lbt_enabled": false } }
  ],
  "topology": {
    "links": [
      { "from": "x_l4",  "to": "gw",   "snr": 24.0, "rssi": -66.0, "bidir": true },
      { "from": "x2_l4", "to": "x_l4", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "x2_l4", "to": "gw",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "y_l5",  "to": "gw",   "snr": 24.0, "rssi": -66.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 70000,  "node": "x_l4", "command": "send_layer 5 1426063461 hello-cross-l4-to-l5" },
    { "at_ms": 100000, "node": "x_l4", "command": "send_channel 7 layer4-only-channel-msg" }
  ],
  "expect": [
    { "type": "script_emit_contains",     "node": "y_l5",  "emit_type": "push", "value": "hello-cross-l4-to-l5" },
    { "type": "script_emit_contains",     "node": "x2_l4", "emit_type": "push", "value": "layer4-only-channel-msg" },
    { "type": "script_emit_not_contains", "node": "y_l5",  "emit_type": "push", "value": "layer4-only-channel-msg" }
  ]
}
