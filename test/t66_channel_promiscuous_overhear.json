{
  "_name": "t66_channel_promiscuous_overhear",
  "_desc": "Verifies the promiscuous-overhearing piggyback (ROADMAP §3 Package A core efficiency feature). alice posts a channel message. bob pulls. alice responds with an M-payload DATA frame addressed to bob. carol is in radio range of alice (NOT bob) but has heard alice's BCN digest too — she scheduled her own pull with random jitter delay. If carol's jitter is longer than the alice→bob exchange takes, she overhears alice's M-response, merges it, AND cancels her own scheduled pull (channel_pull_suppressed event). This is the design's airtime-saving piggyback: one M-response benefits multiple neighbours. Topology: alice ↔ bob, alice ↔ carol (so when alice TXes, both bob and carol receive). Debug window 0-30000ms.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 66,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "debug_start_ms": 0, "debug_end_ms": 30000, "state_snapshot_period_ms": 5000 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "debug_start_ms": 0, "debug_end_ms": 30000, "state_snapshot_period_ms": 5000 } },
    { "name": "carol", "node_id": 3, "key_hash32": "0xCCCCCCCC", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 2000,
        "debug_start_ms": 0, "debug_end_ms": 30000, "state_snapshot_period_ms": 5000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "alice", "to": "carol", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_channel 9 broadcast-msg" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "channel_msg_received", "value": "\"source\":\"self_originate\"" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_msg_received", "value": "\"source\":\"pull_target\"" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "channel_msg_received", "value": "\"source\":\"overheard\"" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "channel_msg_overheard", "value": "\"intended_to\":2" }
  ]
}
