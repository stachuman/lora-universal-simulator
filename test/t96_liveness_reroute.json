{
  "_name": "t96_liveness_reroute",
  "_desc": "Phase-2 routing-liveness gate. alice reaches carol via TWO relays: bob (strong alice-bob link -> the primary path) and dave (weaker -> the alt). bob is a BEST-path relay that DEPARTS: forced_drops kill EVERY bob->alice frame from the 4th occurrence on (the first few establish carol-via-bob on alice, then bob goes silent to alice — no beacon to clear the suspect state, no CTS to alice's RTS). alice sends carol a stream of DMs: the early ones still deliver via the existing same-flight cascade (RTS bob times out -> walk to dave), but each failed flight is liveness evidence -> after a couple, bob's tier crosses suspect/silent and the 40 dB penalty DEMOTES carol-via-bob (rt_penalty_rerank) so subsequent DMs route straight via dave — the reroute. Pre-liveness this stalled (re-RTS the dead bob every flight, up to the 3 h aging TTL). Asserts: delivery CONTINUES (carol receives the later DMs) AND the dead relay is demoted (alice peer_suspect_mark node:2 + rt_penalty_rerank penalized:2). Idle + lossless otherwise (sigma_db=0).",
  "simulation": {
    "duration_ms": 45000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 7,
    "node_startup_jitter_ms": 300,
    "radio": { "sf": 7, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance", "alpha": 3.0, "sigma_db": 0.0,
      "ref_distance_m": 1.0, "ref_loss_db": 40.0, "noise_floor_db": -120.0, "tx_power_dbm": 14.0
    }
  },
  "config": {},
  "nodes": [
    { "name": "alice", "node_id": 1, "engine": "meshroute", "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } },
    { "name": "bob",   "node_id": 2, "engine": "meshroute", "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } },
    { "name": "dave",  "node_id": 3, "engine": "meshroute", "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } },
    { "name": "carol", "node_id": 4, "engine": "meshroute", "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 22.0, "rssi": -62.0, "bidir": true },
      { "from": "bob",   "to": "carol", "snr": 22.0, "rssi": -62.0, "bidir": true },
      { "from": "alice", "to": "dave",  "snr": 12.0, "rssi": -78.0, "bidir": true },
      { "from": "dave",  "to": "carol", "snr": 22.0, "rssi": -62.0, "bidir": true }
    ]
  },
  "forced_drops": [
    { "from": "bob", "to": "alice", "label": "BCN",  "nth": 4, "count": 999 },
    { "from": "bob", "to": "alice", "label": "CTS",  "nth": 1, "count": 999 },
    { "from": "bob", "to": "alice", "label": "ACK",  "nth": 1, "count": 999 }
  ],
  "commands": [
    { "at_ms": 12000, "node": "alice", "command": "send carol m1" },
    { "at_ms": 16000, "node": "alice", "command": "send carol m2" },
    { "at_ms": 20000, "node": "alice", "command": "send carol m3" },
    { "at_ms": 26000, "node": "alice", "command": "send carol m4" },
    { "at_ms": 32000, "node": "alice", "command": "send carol m5" },
    { "at_ms": 38000, "node": "alice", "command": "send carol m6" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "peer_suspect_mark",  "value": "\"node\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_penalty_rerank",  "value": "\"penalized\":2" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "delivered",          "value": "m5" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "delivered",          "value": "m6" }
  ]
}
