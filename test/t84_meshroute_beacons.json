{
  "_name": "t84_meshroute_beacons",
  "_desc": "R1: two engine=meshroute FirmwareNodes run the real meshroute::Node beacon plane — periodic BCN emit (C5 pack_beacon on routing SF) + DV route-table ingest (parse_beacon -> rt_merge). The meshroute parallel of t10_dv_beacons (the Lua reference). Asserts beacon_tx + beacon_rx{src} + rt_update{dest} + rt_full under engine:meshroute. Supersedes the S2 t83 raw-frame skeleton (which tested the now-removed placeholder path).",
  "simulation": {
    "duration_ms": 12000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 500,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "engine": "meshroute",
      "config": { "routing_sf": 7, "beacon_period_ms": 5000, "quiet_threshold_ms": 0, "peer_count": 1 } },
    { "name": "bob",   "engine": "meshroute",
      "config": { "routing_sf": 7, "beacon_period_ms": 5000, "quiet_threshold_ms": 0, "peer_count": 1 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 5.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [],
  "expect": [
    { "type": "event_count_min", "event_type": "script_emit", "node": "alice", "min": 2 },
    { "type": "event_count_min", "event_type": "script_emit", "node": "bob",   "min": 2 },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "beacon_tx", "value": "" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "beacon_tx", "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "beacon_rx", "value": "\"src\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "beacon_rx", "value": "\"src\":0" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_update", "value": "\"dest\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_update", "value": "\"dest\":0" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_full",   "value": "\"peers\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_full",   "value": "\"peers\":1" }
  ]
}
