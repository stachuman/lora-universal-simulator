{
  "_name": "t65_channel_gossip_happy_path",
  "_desc": "Verifies the gossip-based channel propagation (ROADMAP §3 Package A). alice posts a message on channel 7 via send_channel; the message lands in her channel_buffer with dirty=true. Her next BCN carries a CHANNEL_DIGEST extension TLV listing the ID. bob receives the BCN, sees the unknown ID, schedules a Q_CHANNEL_PULL with jitter, and pulls. alice responds with a DATA frame carrying PAYLOAD_TYPE_M (channel message payload). bob merges the message into its own channel_buffer and emits channel_msg_received. Tests the full BCN-digest -> Q-pull -> M-response -> merge cycle end-to-end. Debug window 0-30000ms gives full tracing.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 65,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 30000, "state_snapshot_period_ms": 5000 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 30000, "state_snapshot_period_ms": 5000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_channel 7 hello-world" }
  ],
  "expect": [
    { "type": "cmd_reply_contains", "node": "alice", "command": "send_channel 7 hello-world", "value": "channel msg queued" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "channel_msg_received", "value": "\"source\":\"self_originate\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "channel_msg_received", "value": "\"channel_id\":7" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "beacon_rx", "value": "\"channel_digest_ids\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_pull_sent", "value": "\"trigger\":\"bcn_digest\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "channel_pull_received", "value": "\"from\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "channel_msg_pulled", "value": "\"to\":2" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_msg_received", "value": "\"source\":\"pull_target\"" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_msg_received", "value": "\"channel_id\":7" }
  ]
}
