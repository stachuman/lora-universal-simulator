{
  "_name": "t60_addr_conflict_forced_rejoin",
  "_desc": "Two pre-joined nodes deliberately collide on node_id=5: alice (layer 1, key=0xAAAAAAAA) and bob (layer 2 with leaf_id:1 override so wire leaf matches alice's, key=0xBBBBBBBB). alice starts at t=0; bob's start_at_ms=10000 gives him a smaller lease. They beacon, hear each other on the shared wire leaf, and id_bind_set fires `addr_conflict_observed`. Both sides also fire the new defensive hook: each emits J_DENY with reason=OWN_ID_DEFENSE carrying its lease_age + claim_epoch. The other side's J_DENY handler runs the tie-break (older-lease wins): alice wins, bob loses → bob triggers forced_rejoin → addr_conflict_forced_rejoin → join_start_claim → adopts a new id.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 60,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 5, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "bob", "node_id": 5, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua", "start_at_ms": 10000,
      "config": { "layer_id": 2, "leaf_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "join_listen_ms": 1000, "join_discover_jitter_ms": 500, "join_claim_guard_ms": 2000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "addr_conflict_observed", "value": "\"node\":5" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_observed", "value": "\"node\":5" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "addr_conflict_defense", "value": "\"node\":5" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "addr_conflict_defense", "value": "\"own_key_hash32\":2863311530" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "addr_conflict_defense", "value": "\"claimant_key_hash32\":3149642683" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_defense", "value": "\"node\":5" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_defense", "value": "\"own_key_hash32\":3149642683" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_defense", "value": "\"claimant_key_hash32\":2863311530" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "addr_conflict_tie_break", "value": "\"i_win\":true" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_tie_break", "value": "\"i_win\":false" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_forced_rejoin", "value": "\"prior_node_id\":5" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "addr_conflict_forced_rejoin", "value": "\"reason\":\"addr_conflict_lost\"" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "join_claim_sent", "value": "\"reason\":\"addr_conflict_lost\"" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "join_adopted", "value": "\"key_hash32\":3149642683" }
  ]
