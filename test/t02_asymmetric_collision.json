{
  "_name": "t02_asymmetric_collision",
  "_desc": "alice and carol both broadcast to bob with overlapping airtimes. The fix evaluates collisions bidirectionally at TX-start, so both packets must be marked collided at bob (regression: pre-fix the later-starting carol packet slipped through after alice was delivered + removed from the in-flight list).",
  "simulation": {
    "duration_ms": 10000,
    "step_ms": 1,
    "warmup_ms": 0,
    "radio": { "sf": 11, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "examples/flooder.lua", "config": { "role": "originator" } },
    { "name": "carol", "script": "examples/flooder.lua", "config": { "role": "originator" } },
    { "name": "bob",   "script": "examples/flooder.lua", "config": { "role": "forwarder" } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 8.0, "rssi": -80.0, "bidir": true },
      { "from": "carol", "to": "bob", "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 1000, "node": "alice", "command": "send first" },
    { "at_ms": 1100, "node": "carol", "command": "send second" }
  ],
  "expect": [
    { "type": "event_count_min", "event_type": "collision", "min": 1 }
  ]
}
