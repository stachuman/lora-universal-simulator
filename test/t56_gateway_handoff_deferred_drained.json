{
  "_name": "t56_gateway_handoff_deferred_drained",
  "_desc": "l4_sender wants to reach l5_target's key 0xCAFE0000, but l5_target has no direct link to gw_4 so the gateway has never observed its (layer,key). gw_4 receives the envelope, looks up gateway_remote_bind, gets nil → defers the handoff and floods an 'H' hash-locate query on layer 5 (PROTOCOL §3.7a). l5_helper is in range of both gw_4 and l5_target; it has id_bind[101]=0xCAFE0000 from intra-layer-5 BCNs, resolves the hash, and replies with a routed-DATA binding response back to gw_4. gw_4 receives it, populates gateway_remote_bind, drains the deferred entry via try_drain_gateway_handoffs, and the cross-layer DATA flight reaches l5_target through l5_helper. Timing: the send fires early (3 s) and the run is long (60 s) — the 'H' flood + routed-response round-trip needs more headroom than the old 1-hop Q exchange.",
  "simulation": {
    "duration_ms": 60000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 56,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l4_sender", "node_id": 1, "key_hash32": "0x44000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "gw_4", "node_id": 10, "key_hash32": "0x44000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 8000, "duration_ms": 5000, "offset_ms": 3000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l5_target", "node_id": 101, "key_hash32": "0xcafe0000", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } },
    { "name": "l5_helper", "node_id": 102, "key_hash32": "0x99000000", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "l4_sender", "to": "gw_4", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_4", "to": "l5_helper", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "l5_helper", "to": "l5_target", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 3000, "node": "l4_sender", "command": "send_layer 5 3405643776 hello-via-q-hash" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "l4_sender", "emit_type": "gateway_envelope_enqueued", "value": "\"target_layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_deferred", "value": "\"dst_key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_deferred", "value": "\"q_sent\":true" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "h_tx", "value": "\"key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "l5_helper", "emit_type": "h_resolved", "value": "\"node\":101" },
    { "type": "script_emit_contains", "node": "l5_helper", "emit_type": "h_resolved", "value": "\"key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "q_hash_binding_rx", "value": "\"node\":101" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "q_hash_binding_rx", "value": "\"source\":\"h_query\"" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"node\":101" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_drained", "value": "\"dst_key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_drained", "value": "\"dst\":101" },
    { "type": "script_emit_contains", "node": "l5_target", "emit_type": "delivered", "value": "hello-via-q-hash" }
  ]
