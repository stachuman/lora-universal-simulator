    { "at_ms": 35000, "node": "l3_dst", "command": "send_layer 1,2 3405643778 chain-rev-a" },
    { "at_ms": 55000, "node": "l2_src", "command": "send_layer 1,3 3203334147 chain-fwd-b" },
    { "at_ms": 75000, "node": "l3_dst", "command": "send_layer 1,2 3405643778 chain-rev-b" },
    { "at_ms": 95000, "node": "l2_src", "command": "send_layer 1,3 3203334147 chain-fwd-c" }
