{
  "_name": "t77_gateway_layer_chain",
  "_desc": "Source-routed layer-hop envelope (gateway chaining). Two SEPARATE gateways with NO direct L2<->L3 bridge: gw_a is home L1 / visits L2, gw_b is home L1 / visits L3. l2_src (L2) reaches l3_dst (L3) only via the hub: L2 ->[gw_a]-> L1 ->[gw_b]-> L3. The sender supplies the explicit hop path in the command: 'send_layer 1,3 <hash> <text>' (hops = layers to traverse, last = dst layer). The envelope (in the DATA payload) carries the hop list; gw_a pops the entered layer (L1), emits gateway_envelope_transit, and forwards the remaining path [3] to gw_b, which pops L3 and delivers to the hash. Reverse path uses '1,2'. Verify: gw_a emits gateway_envelope_transit toward L3, and BOTH directions deliver (l3_dst gets chain-fwd, l2_src gets chain-rev).",
  "simulation": {
    "duration_ms": 120000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 77,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l1_hub", "node_id": 1, "key_hash32": "0x11000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "gw_a", "node_id": 10, "key_hash32": "0x11000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 9000, "duration_ms": 3000, "offset_ms": 3000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 120000 } },
    { "name": "gw_b", "node_id": 11, "key_hash32": "0x11000011", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 3, "routing_sf": 9, "allowed_data_sfs": [9], "period_ms": 9000, "duration_ms": 3000, "offset_ms": 6000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 120000 } },
    { "name": "l2_src", "node_id": 101, "key_hash32": "0xcafe0002", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 120000 } },
    { "name": "l3_dst", "node_id": 201, "key_hash32": "0xbeef0003", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 3, "routing_sf": 9, "allowed_data_sfs": [9], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 120000 } }
  ],
  "topology": {
    "links": [
      { "from": "l2_src", "to": "gw_a",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_a",   "to": "l1_hub", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_b",   "to": "l1_hub", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_a",   "to": "gw_b",   "snr": 22.0, "rssi": -68.0, "bidir": true },
