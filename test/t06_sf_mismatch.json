{
  "_name": "t06_sf_mismatch",
  "_desc": "alice TX at SF12; bob runs at SF7 with default sf_rx_set=[7]. R.1.7 single-SF reception drops the packet with drop_sf_mismatch (bob's modem isn't tuned to SF12 — matches real Semtech hardware behaviour). Link SNR is well above any threshold to ensure the SF gate is what fires, not drop_weak.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "examples/sf_picker.lua", "config": {} },
    { "name": "bob",   "script": "examples/sf_picker.lua", "config": {} }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_sf 12 hello-sf12" }
  ],
  "expect": [
    { "type": "event_count_min", "event_type": "drop_sf_mismatch", "node": "bob", "min": 1 },
    { "type": "event_count", "event_type": "rx", "node": "bob", "min": 0, "max": 0 }
  ]
}
