{
  "_name": "t62_send_oversized_and_clamp",
  "_desc": "Two-phase test for the LoRa-frame payload guard. Phase 1 (init): alice's config requests max_payload_bytes=300, which exceeds the LoRa PHY 255-byte frame ceiling minus DATA_HDR_LEN (8) + DATA_INNER_OVERHEAD (6) = 241 hard cap. on_init emits max_payload_clamped with clamped_to=241 and overrides the request. Phase 2 (send-time): alice tries to send a 250-byte payload to bob. With the effective cap now 241, the originator rejects the send before queueing and emits send_oversized with len=250 and max=241. No DATA frame ever hits the radio.",
  "simulation": {
    "duration_ms": 5000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 62,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0,
        "max_payload_bytes": 300 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 2000, "node": "alice", "command": "send bob aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "max_payload_clamped", "value": "\"requested\":300" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "max_payload_clamped", "value": "\"clamped_to\":241" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "max_payload_clamped", "value": "\"lora_max_frame\":255" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "send_oversized", "value": "\"max\":241" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "send_oversized", "value": "\"len\":254" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "send_oversized", "value": "\"dst_name\":\"bob\"" },
    { "type": "cmd_reply_contains", "node": "alice", "value": "ERROR: payload too large" }
  ]
}
