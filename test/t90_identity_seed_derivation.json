{
  "_name": "t90_identity_seed_derivation",
  "_desc": "Slice A2: a node's key_hash32 is DERIVED from its identity `seed` via the device's lib/core/identity (NOT a literal). seed={1..32} -> ed_pub[:4] = 0xf2e6f8d4 = 4075223252 (matches the lib/core golden vector). alice (meshroute) emits its self id_bind_set with the derived key_hash32; bob receives alice's beacon and id_bind_sets the SAME value -> it is on the wire. Both engines read the one SimController _resolved_key_hash32, so the value is identical for engine=lua too (single-source parity).",
  "simulation": {
    "duration_ms": 12000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 1,
    "node_startup_jitter_ms": 0,
    "radio": {
      "sf": 7,
      "bw": 250,
      "cr": 5
    }
  },
  "config": {},
  "nodes": [
    {
      "name": "alice",
      "node_id": 1,
      "seed": "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20",
      "engine": "meshroute",
      "config": {
        "layer_id": 1,
        "routing_sf": 7,
        "beacon_period_ms": 4000,
        "discovery_beacon_period_ms": 2000,
        "quiet_threshold_ms": 0
      }
    },
    {
      "name": "bob",
      "node_id": 2,
      "seed": "02",
      "engine": "meshroute",
      "config": {
        "layer_id": 1,
        "routing_sf": 7,
        "beacon_period_ms": 4000,
        "discovery_beacon_period_ms": 2000,
        "quiet_threshold_ms": 0
      }
    }
  ],
  "topology": {
    "links": [
      {
        "from": "alice",
        "to": "bob",
        "snr": 22.0,
        "rssi": -68.0,
        "bidir": true
      }
    ]
  },
  "expect": [
    {
      "type": "script_emit_contains",
      "node": "alice",
      "emit_type": "id_bind_set",
      "value": "\"key_hash32\":4075223252"
    },
    {
      "type": "script_emit_contains",
      "node": "alice",
      "emit_type": "id_bind_set",
      "value": "\"source\":\"self\""
    },
    {
      "type": "script_emit_contains",
      "node": "bob",
      "emit_type": "id_bind_set",
      "value": "\"key_hash32\":4075223252"
    }
  ]
}