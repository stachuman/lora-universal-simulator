{
  "_name": "t86_meshroute_single_hop",
  "_desc": "R3 T1 gate: two engine=meshroute FirmwareNodes. alice sends to bob (direct neighbour, dest==next-hop) — the full RTS(SF7)->CTS(SF7)->DATA(SF12)->ACK(SF7) flight. Idle + lossless (sigma_db=0) so the happy path is rand-free and lua==meshroute is deterministic. The meshroute parallel of t12_dv_single_hop.",
  "simulation": {
    "duration_ms": 40000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 500,
    "radio": { "sf": 7, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance", "alpha": 3.0, "sigma_db": 0.0,
      "ref_distance_m": 1.0, "ref_loss_db": 40.0, "noise_floor_db": -120.0, "tx_power_dbm": 14.0
    }
  },
  "nodes": [
    { "name": "alice", "engine": "meshroute",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 5000, "quiet_threshold_ms": 0, "peer_count": 1 },
      "lat": 41.3900, "lon": 2.1600 },
    { "name": "bob",   "engine": "meshroute",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 5000, "quiet_threshold_ms": 0, "peer_count": 1 },
      "lat": 41.4035, "lon": 2.1600 }
  ],
  "topology": { "links": [] },
  "commands": [
    { "at_ms": 20000, "node": "alice", "command": "send bob hello-bob" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_full",   "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rts_tx",    "value": "\"dst\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rts_rx",    "value": "\"from\":0" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "cts_tx",    "value": "\"to\":0" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "cts_rx",    "value": "\"from\":1" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "data_tx",   "value": "\"dst\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "data_rx",   "value": "\"from\":0" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "ack_rx",    "value": "\"from\":1" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "delivered", "value": "hello-bob" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "push", "value": "\"kind\":\"send_acked\"" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "push", "value": "\"kind\":\"msg_recv\"" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "push", "value": "hello-bob" },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "alice", "min": 0, "max": 0 },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "bob",   "min": 0, "max": 0 }
  ]
}
