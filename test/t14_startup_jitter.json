{
  "_name": "t14_startup_jitter",
  "_desc": "node_startup_jitter_ms staggers on_init across nodes; node_ready time_ms reflects actual init time, not 0. Seed pins the per-node draws.",
  "simulation": {
    "duration_ms": 2000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 200,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "test/t14_startup_jitter.lua" },
    { "name": "bob",   "script": "test/t14_startup_jitter.lua" },
    { "name": "carol", "script": "test/t14_startup_jitter.lua" },
    { "name": "dave",  "script": "test/t14_startup_jitter.lua" }
  ],
  "topology": { "links": [] },
  "commands": [],
  "expect": [
    { "type": "event_count", "event_type": "node_ready", "count": 4 },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "init_at", "value": "\"time_ms\":75"  },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "init_at", "value": "\"time_ms\":160" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "init_at", "value": "\"time_ms\":191" },
    { "type": "script_emit_contains", "node": "dave",  "emit_type": "init_at", "value": "\"time_ms\":36"  }
  ]
