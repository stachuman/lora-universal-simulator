{
  "_name": "t30_route_query",
  "_desc": "Verifies the 'R' RREQ/RREP route-discovery flood (PROTOCOL §3.7b) that replaced the old single-hop Q ROUTE_QUERY: when an originator sends to an unknown destination, alongside the defer-queue push it floods an RREQ (expanding ring, first probe ttl=1). Forwarders learn the reverse path to the origin; a node that already has the route (or the dst itself) answers with an RREP that lays the forward path hop-by-hop back to the origin. 5-node line a-b-c-d-e; eve joins past warmup and immediately sends to alice (4 hops). Verify: r_tx fires from eve (dst=alice), rreq_rx received at dave (eve's neighbour), rrep_arrived at eve (forward route installed), send_drained + delivered.",
  "simulation": {
    "duration_ms": 60000,
    "step_ms": 1,
    "warmup_ms": 10000,
    "seed": 42,
    "node_startup_jitter_ms": 100,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "bob",   "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "carol", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "dave",  "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "eve",   "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 30000, "quiet_threshold_ms": 0 },
      "start_at_ms": 20000 }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 8.0, "rssi": -80.0, "bidir": true },
      { "from": "bob",   "to": "carol", "snr": 8.0, "rssi": -80.0, "bidir": true },
      { "from": "carol", "to": "dave",  "snr": 8.0, "rssi": -80.0, "bidir": true },
      { "from": "dave",  "to": "eve",   "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 20100, "node": "eve", "command": "send alice hello-via-R" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "eve",   "emit_type": "r_tx",          "value": "alice" },
    { "type": "script_emit_contains", "node": "dave",  "emit_type": "rreq_rx",       "value": "" },
    { "type": "script_emit_contains", "node": "eve",   "emit_type": "rrep_arrived",  "value": "" },
    { "type": "script_emit_contains", "node": "eve",   "emit_type": "send_drained",  "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "delivered",     "value": "hello-via-R" }
  ]
}
