{
  "_name": "t19_clock_drift",
  "_desc": "Three nodes with explicit, very different clock drifts. Each schedules a self:after(10000, ...) at init; the firing time on each node is a fingerprint of how the runtime scaled the delay by 1/(1+drift). Slow node (-500 ppm) fires at wall ≈ 10005 ms with self:now() ≈ 10000 (its perceived 10 s); fast node (+500 ppm) fires at wall ≈ 9995 ms also with self:now() ≈ 10000. Sigmas exaggerated vs. realistic 25 ppm so the wall delta is large enough to assert against without tight tolerance.",
  "simulation": {
    "duration_ms": 12000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "clock_drift_ppm_sigma": 0,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5,
      "rx_preamble_miss_prob": 0.0,
      "hardware": { "decode_margin_steepness_db": 0, "sf_switch_delay_ms": 0 }
    }
  },
  "nodes": [
    { "name": "slow",   "script": "examples/drift_probe.lua",
      "config": { "delay_ms": 10000 }, "clock_drift_ppm": -500 },
    { "name": "perfect","script": "examples/drift_probe.lua",
      "config": { "delay_ms": 10000 }, "clock_drift_ppm": 0 },
    { "name": "fast",   "script": "examples/drift_probe.lua",
      "config": { "delay_ms": 10000 }, "clock_drift_ppm": 500 }
  ],
  "commands": [],
  "expect": [
    { "type": "script_emit_contains", "node": "slow",    "emit_type": "node_clock_profile", "value": "\"clock_drift_ppm\":-500" },
    { "type": "script_emit_contains", "node": "fast",    "emit_type": "node_clock_profile", "value": "\"clock_drift_ppm\":500" },
    { "type": "script_emit_contains", "node": "perfect", "emit_type": "drift_check",        "value": "\"script_now\":10000" },
    { "type": "script_emit_contains", "node": "slow",    "emit_type": "drift_check", "value": "" },
    { "type": "script_emit_contains", "node": "fast",    "emit_type": "drift_check", "value": "" }
  ]
}
