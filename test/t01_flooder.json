{
  "_name": "t01_flooder",
  "_desc": "3-node chain alice → relay → bob. alice sends 'hello'. relay forwards. bob receives + emits 'recv'. ★ A pure-Lua fixture (examples/flooder.lua is not firmware protocol at all), so it tags \"engine\":\"lua\" EXPLICITLY and carries the allow_deprecated_lua opt-in — the 2026-07-25 ruling made \"meshroute\" the default and refuses an unsanctioned Lua node. test/native/test_sim_controller.cpp drives this file through SimController directly and cannot link FirmwareNode.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 500,
    "allow_deprecated_lua": true,
    "radio": { "sf": 11, "bw": 250, "cr": 5, "duty_cycle": 1 }
  },
  "nodes": [
    { "name": "alice", "engine": "lua", "script": "examples/flooder.lua", "config": { "role": "originator" } },
    { "name": "relay", "engine": "lua", "script": "examples/flooder.lua", "config": { "role": "forwarder" } },
    { "name": "bob",   "engine": "lua", "script": "examples/flooder.lua", "config": { "role": "forwarder" } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "relay", "snr": 8.0, "rssi": -80.0, "snr_std_dev": 0, "bidir": true },
      { "from": "relay", "to": "bob",   "snr": 8.0, "rssi": -80.0, "snr_std_dev": 0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send hello" }
  ],
  "expect": [
    { "type": "cmd_reply_contains", "node": "alice", "command": "send hello", "value": "sent seq=1" },
    { "type": "event_count_min",    "event_type": "tx", "min": 2 },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "recv", "value": "hello" }
  ]
}
