{
  "_name": "t52_mobile_identity_beacon",
  "_desc": "Mobile endpoint emits identity-only BCN with key_hash32 but no route entries, so neighbours can bind its short ID without using it as transit.",
  "simulation": {
    "duration_ms": 12000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 52,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance",
      "alpha": 2.4,
      "sigma_db": 0.0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 14.0
    }
  },
  "nodes": [
    { "name": "anchor", "node_id": 10, "key_hash32": "0x10101010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "quiet_threshold_ms": 0 },
      "lat": 41.3900, "lon": 2.1600 },
    { "name": "mobile", "node_id": 77, "key_hash32": "0x4d4d4d4d", "script": "scenarios/dv_dual_sf.lua",
      "config": { "is_mobile": true, "routing_sf": 7, "allowed_data_sfs": [7], "discovery_beacon_period_ms": 1000, "beacon_period_ms": 1000, "quiet_threshold_ms": 0 },
      "lat": 41.3902, "lon": 2.1601,
      "velocity_mps": 1.0, "direction_deg": 90 }
  ],
  "topology": { "links": [] },
  "expect": [
    { "type": "script_emit_contains", "node": "mobile", "emit_type": "beacon_tx", "value": "\"identity_only\":true" },
    { "type": "script_emit_contains", "node": "mobile", "emit_type": "beacon_tx", "value": "\"n_entries\":0" },
    { "type": "script_emit_contains", "node": "anchor", "emit_type": "beacon_rx", "value": "\"src\":77" },
    { "type": "script_emit_contains", "node": "anchor", "emit_type": "beacon_rx", "value": "\"key_hash32\":1296911693" },
    { "type": "script_emit_contains", "node": "anchor", "emit_type": "beacon_rx", "value": "\"identity_only\":true" },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "anchor", "min": 0, "max": 0 },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "mobile", "min": 0, "max": 0 }
  ]
}
