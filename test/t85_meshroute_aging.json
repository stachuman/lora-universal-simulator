{
  "_name": "t85_meshroute_aging",
  "_desc": "R2: three engine=meshroute FirmwareNodes in a line a-b-c. carol dies at 20000. With short config TTLs (15000) + frequent aging checks (5000), alice/bob age out their route to carol within ~15-20s. The meshroute parallel of t29_route_aging (the Lua reference). Exercises aging/eviction + triggered-on-evict + dirty-only steady beacons + discovery-exit. Asserts rt_aged (carol) + bcn_discovery_exit + beacon_tx/beacon_rx/rt_update + rt_full under engine:meshroute.",
  "simulation": {
    "duration_ms": 60000,
    "step_ms": 1,
    "warmup_ms": 5000,
    "seed": 42,
    "node_startup_jitter_ms": 100,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "engine": "meshroute",
      "config": { "routing_sf": 7, "beacon_period_ms": 5000, "quiet_threshold_ms": 0,
                  "rt_aging_ttl_neighbor_ms": 15000, "rt_aging_ttl_remote_ms": 15000,
                  "rt_aging_check_period_ms": 5000, "seen_bitmap_enabled": false, "peer_count": 2 } },
    { "name": "bob",   "engine": "meshroute",
      "config": { "routing_sf": 7, "beacon_period_ms": 5000, "quiet_threshold_ms": 0,
                  "rt_aging_ttl_neighbor_ms": 15000, "rt_aging_ttl_remote_ms": 15000,
                  "rt_aging_check_period_ms": 5000, "seen_bitmap_enabled": false, "peer_count": 2 } },
    { "name": "carol", "engine": "meshroute",
      "config": { "routing_sf": 7, "beacon_period_ms": 5000, "quiet_threshold_ms": 0,
                  "rt_aging_ttl_neighbor_ms": 15000, "rt_aging_ttl_remote_ms": 15000,
                  "rt_aging_check_period_ms": 5000, "seen_bitmap_enabled": false, "peer_count": 2 },
      "dies_at_ms": 20000 }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 8.0, "rssi": -80.0, "bidir": true },
      { "from": "bob",   "to": "carol", "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "beacon_tx",          "value": "" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "beacon_tx",          "value": "" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "beacon_tx",          "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "bcn_discovery_exit", "value": "" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "bcn_discovery_exit", "value": "" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "bcn_discovery_exit", "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_update",          "value": "\"dest\":2" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_update",          "value": "\"dest\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_full",            "value": "\"peers\":2" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_full",            "value": "\"peers\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_aged",            "value": "\"dest\":2" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_aged",            "value": "\"dest\":2" }
  ]
}
