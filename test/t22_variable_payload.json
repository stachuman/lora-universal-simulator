{
  "_name": "t22_variable_payload",
  "_desc": "Three-node chain (alice → relay → bob). Alice sends two messages: a short 8-byte payload and a long 200-byte payload. The RTS now carries payload_len, so the relay's pending_rx_expiry is sized to actual airtime instead of max_payload_bytes worst-case — short flights free pending_rx ~2× faster. Both messages must deliver, and at least one rts_tx event from alice carries payload_len > 100 (the long flight) plus one with payload_len < 50 (the short flight) — proves the field is on the wire.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 5000,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "clock_drift_ppm_sigma": 0,
    "radio": {
      "sf": 8, "bw": 250, "cr": 5, "max_packet_bytes": 255,
      "rx_preamble_miss_prob": 0.0,
      "hardware": { "decode_margin_steepness_db": 0, "sf_switch_delay_ms": 0 }
    },
    "path_loss": {
      "model": "log_distance", "alpha": 3.0, "sigma_db": 0.0,
      "node_tx_offset_sigma_db": 0, "node_rx_offset_sigma_db": 0,
      "asymmetry_coherence_ms": 0,
      "ref_distance_m": 1.0, "ref_loss_db": 40.0,
      "noise_floor_db": -120.0, "tx_power_dbm": 14.0
    }
  },
  "nodes": [
    { "name": "alice", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "max_payload_bytes": 220, "lbt_enabled": false },
      "lat": 41.3900, "lon": 2.1600 },
    { "name": "relay", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "max_payload_bytes": 220, "lbt_enabled": false },
      "lat": 41.3905, "lon": 2.1600 },
    { "name": "bob",   "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "max_payload_bytes": 220, "lbt_enabled": false },
      "lat": 41.3910, "lon": 2.1600 }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "relay", "snr": 15.0, "rssi": -75.0, "bidir": true },
      { "from": "relay", "to": "bob",   "snr": 15.0, "rssi": -75.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 8000,  "node": "alice", "command": "send bob short!" },
    { "at_ms": 18000, "node": "alice", "command": "send bob 0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "bob", "emit_type": "delivered", "value": "short!" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "delivered", "value": "0123456789" }
  ]
}
