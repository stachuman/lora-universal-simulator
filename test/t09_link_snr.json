{
  "_name": "t09_link_snr",
  "_desc": "sim:link_snr Lua query: alice and bob deployed via lat/lon ~100m apart with the log-distance path-loss model -> SNR ~40 dB. snr_probe.lua emits a link_snr event with the value at on_init. Asserts the event fires and SNR is in the expected band.",
  "simulation": {
    "duration_ms": 1000,
    "step_ms": 1,
    "warmup_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance",
      "alpha": 3.0,
      "sigma_db": 0.0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 20.0
    }
  },
  "nodes": [
    { "name": "alice", "script": "examples/snr_probe.lua", "config": {}, "lat": 41.3900, "lon": 2.1600 },
    { "name": "bob",   "script": "examples/snr_probe.lua", "config": {}, "lat": 41.3909, "lon": 2.1600 }
  ],
  "topology": { "links": [] },
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "link_snr", "value": "\"peer\":\"bob\"" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "link_snr", "value": "\"peer\":\"alice\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "link_snr", "value": "\"snr_db\":40" }
  ]
}
