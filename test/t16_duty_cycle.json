{
  "_name": "t16_duty_cycle",
  "_desc": "Verify duty-cycle accounting: 1% over a 10s window = 100ms budget. SF12 30-byte payload (~1.1s airtime) breaches the budget on the very first TX; subsequent attempts are self-deferred via the Lua pre-check (duty_cycle_blocked emit) and any runtime hard-block fires radio_busy with reason=duty_cycle_exceeded.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "radio": {
      "sf": 8,
      "bw": 250,
      "cr": 5,
      "duty_cycle": 2,
      "duty_cycle_window_ms": 10000
    }
  },
  "nodes": [
    { "name": "alice", "script": "test/t16_duty_cycle.lua" },
    { "name": "bob",   "script": "test/t16_duty_cycle.lua" }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 1000, "node": "alice", "command": "burn" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "duty_cycle_blocked", "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "burn_tx",          "value": "\"idx\":1" },
    { "type": "event_count_min", "event_type": "tx", "node": "alice", "min": 1 }
  ]
}
