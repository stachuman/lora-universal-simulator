{
  "_name": "t13_radio_busy_info",
  "_desc": "Verify on_radio_busy(self, info) carries reason/len/sf/label/tx_info/busy_until_ms and that self:channel_busy_until / self:tx_in_flight read non-zero in the right windows. alice TXes a long SF12 packet at t=1000; bob's TX at t=1100 trips channel_busy; alice's second TX at t=1200 trips self_tx_in_flight. cad_miss_prob=0 makes LBT detection deterministic.",
  "simulation": {
    "duration_ms": 5000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 500,
    "radio": { "sf": 12, "bw": 250, "cr": 5, "cad_miss_prob": 0.0 }
  },
  "nodes": [
    { "name": "alice", "script": "test/t13_radio_busy_info.lua" },
    { "name": "bob",   "script": "test/t13_radio_busy_info.lua" }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 8.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 1000, "node": "alice", "command": "long"  },
    { "at_ms": 1100, "node": "bob",   "command": "short" },
    { "at_ms": 1200, "node": "alice", "command": "short" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "busy_observed", "value": "\"reason\":\"channel_busy\""      },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "busy_observed", "value": "\"sf\":12"                          },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "busy_observed", "value": "\"label\":\"SHORT\""               },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "busy_observed", "value": "\"tx_info\":\"pong\""              },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "busy_observed", "value": "\"reason\":\"self_tx_in_flight\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "busy_observed", "value": "\"label\":\"SHORT\""               },
    { "type": "event_count", "event_type": "tx_deferred", "min": 2, "max": 10 }
  ]
}
