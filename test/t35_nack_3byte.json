{
  "_name": "t35_nack_3byte",
  "_desc": "3-byte NACK wire-format round-trip test. hub_busy has an ultra-tight budget (critical_pct=0.3%) so it enters BUDGET_TIER_CRITICAL immediately on its first beacon. When alice sends to dave via hub_busy, hub_busy emits a BUDGET NACK encoded in the new 3-byte format; alice decodes it and emits nack_rx. Verifies: (1) hub_busy emits nack_tx (pack_nack 3-byte fires); (2) alice emits nack_rx with reason=budget_low (parse_nack 3-byte decodes correctly); (3) msg-a is eventually delivered via hub_idle, proving retry after NACK works.",
  "simulation": {
    "duration_ms": 60000,
    "step_ms": 1,
    "warmup_ms": 2000,
    "seed": 35,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 8, "bw": 250, "cr": 5, "duty_cycle": 0.01, "duty_cycle_window_ms": 3600000 }
  },
  "nodes": [
    { "name": "alice",    "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9, 10],
                  "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } },
    { "name": "hub_busy", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9, 10],
                  "beacon_period_ms": 5000, "quiet_threshold_ms": 0,
                  "budget_strained_pct":  0.1,
                  "budget_critical_pct":  0.3,
                  "budget_exhausted_pct": 95 } },
    { "name": "hub_idle", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9, 10],
                  "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } },
    { "name": "dave",     "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [9, 10],
                  "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "alice",    "to": "hub_busy", "snr": 12.0, "rssi": -78.0, "bidir": true },
      { "from": "alice",    "to": "hub_idle", "snr":  8.0, "rssi": -84.0, "bidir": true },
      { "from": "hub_busy", "to": "dave",     "snr": 12.0, "rssi": -78.0, "bidir": true },
      { "from": "hub_idle", "to": "dave",     "snr":  8.0, "rssi": -84.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 15000, "node": "alice", "command": "send dave msg-a" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "hub_busy", "emit_type": "nack_tx",        "value": "budget_low" },
    { "type": "script_emit_contains", "node": "alice",    "emit_type": "nack_rx",         "value": "budget_low" },
    { "type": "script_emit_contains", "node": "dave",     "emit_type": "delivered",       "value": "msg-a" }
  ]
}
