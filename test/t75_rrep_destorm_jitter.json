{
  "_name": "t75_rrep_destorm_jitter",
  "_desc": "Regression for Phase-2 schedule-aware RREP (send_route_reply). gw_a is home on L1 and makes a VERY SHORT visit to L2 (700ms every 8s). l1_src sends cross-layer to target, which is two hops away on L2 via r1, so gw_a must run an 'F' RREQ flood on L2 and receive the RREP back. The flood goes out during gw_a's brief L2 window, but by the time r1 has the RREP to relay back to gw_a, gw_a has already hopped home — so under the OLD code r1 would fire the RREP via tx_initiating blind into the away-gap and gw_a would never decode it (route never installs). Under the fix r1 sees gw_a's advertised schedule and holds the RREP until gw_a's next L2 window (rrep_gateway_schedule_defer). Verify: r1 emits rrep_gateway_schedule_defer naming gw_a, and target is delivered.",
  "simulation": {
    "duration_ms": 90000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 75,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l1_src", "node_id": 1, "key_hash32": "0x11000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 90000 } },
    { "name": "gw_a", "node_id": 10, "key_hash32": "0x11000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 8000, "duration_ms": 700, "offset_ms": 4000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "r1", "node_id": 100, "key_hash32": "0xcafe0001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 90000 } },
    { "name": "target", "node_id": 101, "key_hash32": "0xcafe0002", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "l1_src", "to": "gw_a",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_a",   "to": "r1",     "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "r1",     "to": "target", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 20000, "node": "l1_src", "command": "send_layer 2 3405643778 xl-a" },
    { "at_ms": 40000, "node": "l1_src", "command": "send_layer 2 3405643778 xl-b" },
    { "at_ms": 60000, "node": "l1_src", "command": "send_layer 2 3405643778 xl-c" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "r1", "emit_type": "rrep_gateway_schedule_defer", "value": "\"next_hop\":10" },
    { "type": "script_emit_contains", "node": "target", "emit_type": "delivered", "value": "xl-" }
  ]
}
