{
  "_name": "t74_gateway_offlayer_route_discovery",
  "_desc": "Regression for Phase-1 layer-gated route discovery (try_drain_deferred). gw_a is home on L1 and time-shares TWO visit layers, L2 and L3 (each a 3s window every 9s). l1_src sends cross-layer to l2_dst AND l3_dst concurrently; both live two hops from gw_a (via a relay) so gw_a must run an 'F' RREQ flood on the respective layer to route each forward. Because the gateway can only be on one layer at a time, whenever it is servicing/visiting one layer the other layer's forward is pending-and-routeless on a layer it is not on. The OLD code would flood that forward's RREQ on whatever layer the gateway happened to be on (wrong layer): wasted airtime + per-dst dedup poisoning. The fix emits send_defer_requery_offlayer (no wrong-layer flood) and floods only when back on the target layer. Verify: gw_a emits send_defer_requery_offlayer, and BOTH l2_dst and l3_dst deliver.",
  "simulation": {
    "duration_ms": 120000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 74,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l1_src", "node_id": 1, "key_hash32": "0x11000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 120000 } },
    { "name": "gw_a", "node_id": 10, "key_hash32": "0x11000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "is_gateway": true,
        "gateway_layers": [
          { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 9000, "duration_ms": 3000, "offset_ms": 3000 },
          { "layer_id": 3, "routing_sf": 9, "allowed_data_sfs": [9], "period_ms": 9000, "duration_ms": 3000, "offset_ms": 6000 }
        ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l2_relay", "node_id": 100, "key_hash32": "0xcafe0001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l2_dst", "node_id": 101, "key_hash32": "0xcafe0002", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l3_relay", "node_id": 200, "key_hash32": "0xbeef0001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 3, "routing_sf": 9, "allowed_data_sfs": [9], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l3_dst", "node_id": 201, "key_hash32": "0xbeef0002", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 3, "routing_sf": 9, "allowed_data_sfs": [9], "beacon_period_ms": 4000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "l1_src",   "to": "gw_a",     "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_a",     "to": "l2_relay", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "l2_relay", "to": "l2_dst",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_a",     "to": "l3_relay", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "l3_relay", "to": "l3_dst",   "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 20000, "node": "l1_src", "command": "send_layer 2 3405643778 xl2-a" },
    { "at_ms": 20500, "node": "l1_src", "command": "send_layer 3 3203334146 xl3-a" },
    { "at_ms": 45000, "node": "l1_src", "command": "send_layer 2 3405643778 xl2-b" },
    { "at_ms": 45500, "node": "l1_src", "command": "send_layer 3 3203334146 xl3-b" },
    { "at_ms": 70000, "node": "l1_src", "command": "send_layer 2 3405643778 xl2-c" },
    { "at_ms": 70500, "node": "l1_src", "command": "send_layer 3 3203334146 xl3-c" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "gw_a", "emit_type": "send_defer_requery_offlayer", "value": "tx_layer_id" },
    { "type": "script_emit_contains", "node": "l2_dst", "emit_type": "delivered", "value": "xl2-" },
    { "type": "script_emit_contains", "node": "l3_dst", "emit_type": "delivered", "value": "xl3-" }
  ]
