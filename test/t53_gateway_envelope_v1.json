{
  "_name": "t53_gateway_envelope_v1",
  "_desc": "Gateway V1: source sends layer_path+key_hash envelope to a gateway; gateway resolves the target binding and re-enqueues local DATA. This uses a shared test leaf_id to smoke-test the handoff before real TDM retune lands.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 53,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0x11111111", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } },
    { "name": "gw", "node_id": 10, "key_hash32": "0x22222222", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "is_gateway": true, "gateway_layers": [ { "layer_id": 2, "leaf_id": 1 } ], "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } },
    { "name": "remote", "node_id": 33, "key_hash32": "0x33333333", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 2, "leaf_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "gw", "snr": 20.0, "rssi": -70.0, "bidir": true },
      { "from": "gw", "to": "remote", "snr": 20.0, "rssi": -70.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 18000, "node": "alice", "command": "send_layer 2 858993459 hello-via-gateway" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "gateway_envelope_enqueued", "value": "\"target_layer_id\":2" },
    { "type": "script_emit_contains", "node": "gw", "emit_type": "gateway_handoff_enqueued", "value": "\"dst\":33" },
    { "type": "script_emit_contains", "node": "remote", "emit_type": "delivered", "value": "hello-via-gateway" }
  ]
}
