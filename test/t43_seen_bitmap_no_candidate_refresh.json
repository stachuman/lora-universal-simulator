{
  "_name": "t43_seen_bitmap_no_candidate_refresh",
  "_desc": "Seen bitmap updates destination freshness and refreshes only existing candidates via the bitmap sender. Alice learns carol via bob, then bob's later bitmap refreshes that candidate without creating new routes.",
  "simulation": {
    "duration_ms": 20000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 8, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "req_sync_on_boot": false, "sync_response_enabled": false, "rt_aging_ttl_remote_ms": 3000, "rt_aging_check_period_ms": 500, "seen_bitmap_ttl_ms": 30000 } },
    { "name": "bob", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "req_sync_on_boot": false, "sync_response_enabled": false, "rt_aging_ttl_remote_ms": 3000, "rt_aging_check_period_ms": 500, "seen_bitmap_ttl_ms": 30000 } },
    { "name": "carol", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 1000, "quiet_threshold_ms": 0, "req_sync_on_boot": false, "sync_response_enabled": false, "rt_aging_ttl_remote_ms": 3000, "rt_aging_check_period_ms": 500, "seen_bitmap_ttl_ms": 30000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": 10.0, "rssi": -80.0, "bidir": true },
      { "from": "bob", "to": "carol", "snr": 10.0, "rssi": -80.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 10800, "node": "alice", "command": "send carol bitmap-q-repair" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "seen_bitmap_rx", "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_bitmap_refresh", "value": "\"dest\":2" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "delivered", "value": "bitmap-q-repair" }
  ]
}
