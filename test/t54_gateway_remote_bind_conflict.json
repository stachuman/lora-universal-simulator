{
  "_name": "t54_gateway_remote_bind_conflict",
  "_desc": "Two layer-5 nodes share key_hash32=0xCAFE0000 (3405643776) but own different node_ids (101 and 102). During gw_4's sweeps to layer 5, it observes both BCNs; the second observation flips gateway_remote_bind[(layer=5,key=0xCAFE0000)].ambiguous=true and emits gateway_remote_bind_conflict. Once set, the ambiguous flag is sticky across subsequent same-node refreshes (TTL eviction is the only clearer). A cross-layer send from l4_sender addressed to 0xCAFE0000 then gets gateway_no_binding with reason=\"ambiguous\" and is NOT handed off. l5_b starts after l5_a so the first observation is from l5_a; the conflict fires once l5_b's first BCN reaches gw_4 during a sweep.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 54,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l4_sender", "node_id": 1, "key_hash32": "0x44000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "gw_4", "node_id": 10, "key_hash32": "0x44000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 8000, "duration_ms": 5000, "offset_ms": 2000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "l5_a", "node_id": 101, "key_hash32": "0xcafe0000", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } },
    { "name": "l5_b", "node_id": 102, "key_hash32": "0xcafe0000", "script": "scenarios/dv_dual_sf.lua", "start_at_ms": 8000,
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 3000, "discovery_beacon_period_ms": 1500, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "l4_sender", "to": "gw_4", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_4", "to": "l5_a", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "gw_4", "to": "l5_b", "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "l5_a", "to": "l5_b", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 20000, "node": "l4_sender", "command": "send_layer 5 3405643776 try-ambiguous" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"node\":101" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_conflict", "value": "\"key_hash32\":3405643776" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_conflict", "value": "\"existing_node\":101" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_conflict", "value": "\"conflicting_node\":102" },
    { "type": "script_emit_contains", "node": "l4_sender", "emit_type": "gateway_envelope_enqueued", "value": "\"target_layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_no_binding", "value": "\"reason\":\"ambiguous\"" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_no_binding", "value": "\"dst_key_hash32\":3405643776" },
