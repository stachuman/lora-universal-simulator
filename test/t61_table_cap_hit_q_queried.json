{
  "_name": "t61_table_cap_hit_q_queried",
  "_desc": "Bounded-state cap audit: alice has cap_route_request_last=2 and sends to three distinct unknown destinations (bob, charlie, dave). With no topology links she has no routes, so each send falls into defer_send_for_route -> emit_route_request, which writes a new key into self.route_request_last (the origination-side per-dst table that replaced the old q_queried route-query table). The first two writes succeed (size 0->1, 1->2); the third hits the cap and is refused with a `table_cap_hit` event carrying table='route_request_last', size=2, cap=2, action='refuse'. Verifies the pre-port hardening helper fires correctly and the run-quality telemetry surfaces it. Deferred-send requeries re-hit the cap for dave (still uninserted), producing additional cap-hit events.",
  "simulation": {
    "duration_ms": 8000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 61,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice",   "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0,
        "cap_route_request_last": 2 } },
    { "name": "bob",     "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "charlie", "node_id": 3, "key_hash32": "0xCCCCCCCC", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0 } },
    { "name": "dave",    "node_id": 4, "key_hash32": "0xDDDDDDDD", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": []
  },
  "commands": [
    { "at_ms": 2000, "node": "alice", "command": "send bob   first" },
    { "at_ms": 3000, "node": "alice", "command": "send charlie second" },
    { "at_ms": 4000, "node": "alice", "command": "send dave  third" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "table_cap_hit", "value": "\"table\":\"route_request_last\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "table_cap_hit", "value": "\"cap\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "table_cap_hit", "value": "\"size\":2" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "table_cap_hit", "value": "\"action\":\"refuse\"" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "table_cap_hit", "value": "\"key\":\"dst:4\"" }
  ]
}
