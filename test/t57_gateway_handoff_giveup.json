{
  "_name": "t57_gateway_handoff_giveup",
  "_desc": "l4_sender targets a key in layer 5 that no peer knows. gw_4 has no layer-5 neighbours, so its 'H' hash-locate flood (PROTOCOL §3.7a) reaches no one and gets no binding response. After gateway_handoff_defer_ttl_ms (set to 5 s for fast test) the drain loop fires gateway_handoff_giveup and removes the deferred entry. The drain loop runs ~every 1 s inside drain_loop, so the giveup fires within ~1 s of the TTL.",
  "simulation": {
    "duration_ms": 20000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 57,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "l4_sender", "node_id": 1, "key_hash32": "0x44000001", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } },
    { "name": "gw_4", "node_id": 10, "key_hash32": "0x44000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 8000, "duration_ms": 5000, "offset_ms": 2000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 5000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "gateway_handoff_defer_ttl_ms": 5000 } }
  ],
  "topology": {
    "links": [
      { "from": "l4_sender", "to": "gw_4", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 8000, "node": "l4_sender", "command": "send_layer 5 3735928559 nobody-home" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "l4_sender", "emit_type": "gateway_envelope_enqueued", "value": "\"target_layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_deferred", "value": "\"dst_key_hash32\":3735928559" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_deferred", "value": "\"q_sent\":true" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "h_tx", "value": "\"key_hash32\":3735928559" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "h_tx", "value": "\"ttl\":16" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_giveup", "value": "\"dst_key_hash32\":3735928559" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_handoff_giveup", "value": "\"target_layer_id\":5" },
    { "type": "event_count", "event_type": "gateway_handoff_enqueued", "node": "gw_4", "min": 0, "max": 0 }
  ]
}
