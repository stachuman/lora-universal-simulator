{
  "_name": "t03_drop_weak",
  "_desc": "alice and bob both at SF7 (default sf_rx_set=[7]). Link SNR -10 dB is below SF7 threshold -7.5 dB so two TX attempts both drop_weak. With single-SF reception default (R.1.7), no cross-SF tricks; this directly exercises the SNR-threshold gate.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "script": "examples/sf_picker.lua", "config": {} },
    { "name": "bob",   "script": "examples/sf_picker.lua", "config": {} }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob", "snr": -10.0, "rssi": -110.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_sf 7 hello-sf7" }
  ],
  "expect": [
    { "type": "event_count_min", "event_type": "drop_weak", "node": "bob", "min": 1 }
  ]
}
