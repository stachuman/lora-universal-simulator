{
  "_name": "t55_gateway_remote_bind_aged",
  "_desc": "Gateway gw_4 sweeps to layer 5, hears BCNs from l5_quiet during the first sweep window, and registers gateway_remote_bind. l5_quiet has a long beacon_period (60 s), so after the first sweep ends it does not beacon again within the test duration. With gateway_remote_bind_ttl_ms=8000 and rt_aging_check_period_ms=2000, the binding ages out and gw_4 emits gateway_remote_bind_aged. Verifies the TTL+aging path for stale remote bindings.",
  "simulation": {
    "duration_ms": 25000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 55,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "gw_4", "node_id": 10, "key_hash32": "0x44000010", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 4, "is_gateway": true,
        "gateway_layers": [ { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "period_ms": 30000, "duration_ms": 5000, "offset_ms": 2000 } ],
        "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0,
        "gateway_remote_bind_ttl_ms": 8000, "rt_aging_check_period_ms": 2000 } },
    { "name": "l5_quiet", "node_id": 101, "key_hash32": "0x55000101", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 5, "routing_sf": 8, "allowed_data_sfs": [8], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 2000, "quiet_threshold_ms": 0 } }
  ],
  "topology": {
    "links": [
      { "from": "gw_4", "to": "l5_quiet", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "expect": [
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"key_hash32\":1426063617" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"node\":101" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_set", "value": "\"layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_aged", "value": "\"key_hash32\":1426063617" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_aged", "value": "\"layer_id\":5" },
    { "type": "script_emit_contains", "node": "gw_4", "emit_type": "gateway_remote_bind_aged", "value": "\"node\":101" }
  ]
}
