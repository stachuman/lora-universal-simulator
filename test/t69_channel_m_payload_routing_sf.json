{
  "_name": "t69_channel_m_payload_broadcast",
  "_desc": "Verifies the 2B-broadcast M-payload mechanism (commit 3af2be1+). alice posts a channel msg; bob pulls (short jitter 100ms); alice responds with an M_BROADCAST RTS that announces chosen_data_sf = max(allowed_data_sfs) = SF10, then broadcasts DATA-M at SF10. No CTS, no ACK — fire-and-forget. bob is the addressed target (his Q triggered the response); he merges as source=pull_target. carol is in radio range of alice and decodes alice's M_BROADCAST RTS; she arms overhear-retune (channel_overhear_armed event) and may decode the DATA-M at SF10. Topology: alice↔bob, alice↔carol, NO bob↔carol. Note: under 2B-broadcast carol's overhear depends on tight retune timing — the test asserts she ARMS, not that she necessarily decodes (which would be flaky across seed/SF combinations).",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 69,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "config": { "debug_start_ms": 0, "debug_end_ms": 30000 },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "state_snapshot_period_ms": 5000 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "state_snapshot_period_ms": 5000 } },
    { "name": "carol", "node_id": 3, "key_hash32": "0xCCCCCCCC", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 5000,
        "state_snapshot_period_ms": 5000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "alice", "to": "carol", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_channel 7 broadcast-test" }
  ],
  "expect": [
    { "type": "cmd_reply_contains", "node": "alice", "command": "send_channel 7 broadcast-test", "value": "queued" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "data_tx", "value": "\"m_broadcast\":true" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "data_tx", "value": "\"sf\":10" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_overhear_armed", "value": "\"chosen_data_sf\":10" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_msg_received",  "value": "\"source\":\"pull_target\"" }
  ]
}
