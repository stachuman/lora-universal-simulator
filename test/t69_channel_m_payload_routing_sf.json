{
  "_name": "t69_channel_m_payload_routing_sf",
  "_desc": "Verifies the 2A change: M-payload (channel gossip DATA frame) is restricted to the routing SF so non-target peers tuned to routing SF can promiscuously overhear it. Topology: alice ↔ bob, alice ↔ carol (NO bob ↔ carol link), routing_sf=7, allowed_data_sfs=[7,9,10]. alice posts a channel msg. bob pulls (short jitter 100ms). alice responds with M-payload DATA — under 2A the DATA frame is forced to SF7 (routing_sf), so carol (on SF7 waiting for BCNs) decodes it and emits channel_msg_received{source=overheard}. Pre-2A: alice would have chosen SF9 or SF10 for DATA based on link SNR + sf_bitmap; carol on SF7 would drop with drop_sf_mismatch. carol's pending pull (jitter 5000ms) is cancelled by the overhear before firing.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 69,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "config": { "debug_start_ms": 0, "debug_end_ms": 30000 },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "state_snapshot_period_ms": 5000 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 100,
        "state_snapshot_period_ms": 5000 } },
    { "name": "carol", "node_id": 3, "key_hash32": "0xCCCCCCCC", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7, 9, 10], "beacon_period_ms": 8000, "discovery_beacon_period_ms": 4000, "quiet_threshold_ms": 0,
        "channel_pull_jitter_ms": 5000,
        "state_snapshot_period_ms": 5000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "alice", "to": "carol", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms": 5000, "node": "alice", "command": "send_channel 7 routing-sf-overhear" }
  ],
  "expect": [
    { "type": "cmd_reply_contains", "node": "alice", "command": "send_channel 7 routing-sf-overhear", "value": "channel msg queued" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "data_tx",             "value": "\"sf\":7" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "channel_msg_received","value": "\"source\":\"pull_target\"" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "channel_msg_received","value": "\"source\":\"overheard\"" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "channel_msg_overheard","value": "\"intended_to\":2" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "channel_pull_suppressed", "value": "\"overheard_from\":1" }
  ]
}
