    "duration_ms": 90000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 76,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
