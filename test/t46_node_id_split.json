{
  "_name": "t46_node_id_split",
  "_desc": "Protocol node_id is separate from node array index/name. alice and bob use non-index node IDs, but commands still address by name and the DATA path uses node_id on wire.",
  "simulation": {
    "duration_ms": 40000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 46,
    "node_startup_jitter_ms": 500,
    "radio": { "sf": 7, "bw": 250, "cr": 5 },
    "path_loss": {
      "model": "log_distance",
      "alpha": 3.0,
      "sigma_db": 0.0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 14.0
    }
  },
  "nodes": [
    { "name": "alice", "node_id": 7, "key_hash32": "0x11111111", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 5000, "quiet_threshold_ms": 0 },
      "lat": 41.3900, "lon": 2.1600 },
    { "name": "bob", "node_id": 42, "key_hash32": "0x22222222", "script": "scenarios/dv_dual_sf.lua",
      "config": { "routing_sf": 7, "data_sf": 12, "beacon_period_ms": 5000, "quiet_threshold_ms": 0 },
      "lat": 41.4035, "lon": 2.1600 }
  ],
  "topology": { "links": [] },
  "commands": [
    { "at_ms": 20000, "node": "alice", "command": "send bob hello-bob" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rt_full",   "value": "" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rt_full",   "value": "" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "id_bind_set", "value": "\"node\":7" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "id_bind_set", "value": "\"key_hash32\":286331153" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "id_bind_set", "value": "\"node\":42" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "id_bind_set", "value": "\"key_hash32\":572662306" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "rts_tx",    "value": "\"dst\":42" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "rts_rx",    "value": "\"from\":7" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "cts_tx",    "value": "\"to\":7" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "cts_rx",    "value": "\"from\":42" },
    { "type": "script_emit_contains", "node": "alice", "emit_type": "data_tx",   "value": "\"dst\":42" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "data_rx",   "value": "\"from\":7" },
    { "type": "script_emit_contains", "node": "bob",   "emit_type": "delivered", "value": "hello-bob" },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "alice", "min": 0, "max": 0 },
    { "type": "event_count", "event_type": "drop_sf_mismatch", "node": "bob",   "min": 0, "max": 0 }
  ]
}
