{
  "_name": "t45_mobile_path_loss_overrides_static_links",
  "_desc": "A mobile endpoint must use path-loss-derived link quality even when topology.links contains a stale generated snapshot for the same pair.",
  "simulation": {
    "duration_ms": 1000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 42,
    "node_startup_jitter_ms": 0,
    "clock_drift_ppm_sigma": 0,
    "radio": {
      "sf": 7,
      "bw": 250,
      "cr": 5,
      "rx_preamble_miss_prob": 0.0,
      "hardware": {
        "decode_margin_steepness_db": 0,
        "sf_switch_delay_ms": 0
      }
    },
    "path_loss": {
      "model": "log_distance",
      "alpha": 3.0,
      "sigma_db": 0.0,
      "node_tx_offset_sigma_db": 0.0,
      "node_rx_offset_sigma_db": 0.0,
      "asymmetry_coherence_ms": 0,
      "ref_distance_m": 1.0,
      "ref_loss_db": 40.0,
      "noise_floor_db": -120.0,
      "tx_power_dbm": 20.0
    }
  },
  "nodes": [
    {
      "name": "alice",
      "script": "examples/snr_probe.lua",
      "config": {},
      "lat": 41.3900,
      "lon": 2.1600,
      "velocity_mps": 1.0,
      "direction_deg": 0
    },
    {
      "name": "bob",
      "script": "examples/snr_probe.lua",
      "config": {},
      "lat": 41.3909,
      "lon": 2.1600
    }
  ],
  "topology": {
    "links": [
      {
        "from": "alice",
        "to": "bob",
        "snr": 99.0,
        "rssi": -10.0,
        "snr_std_dev": 0.0,
        "bidir": true
      }
    ]
  },
  "expect": [
    {
      "type": "script_emit_contains",
      "node": "alice",
      "emit_type": "link_snr",
      "value": "\"peer\":\"bob\""
    },
    {
      "type": "script_emit_contains",
      "node": "alice",
      "emit_type": "link_snr",
      "value": "\"snr_db\":40"
    },
    {
      "type": "script_emit_contains",
      "node": "bob",
      "emit_type": "link_snr",
      "value": "\"snr_db\":40"
    }
  ]
}
