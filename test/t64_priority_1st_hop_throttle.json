{
  "_name": "t64_priority_1st_hop_throttle",
  "_desc": "Verifies the 1st-hop priority anti-spam ledger (ROADMAP §3a backstop). alice has `originator_priority_max_per_window: 100` (effectively disabled self-cap — simulates a misbehaving / malicious sender bypassing originator throttle). bob (1st-hop forwarder) keeps the default cap=5, observes alice's priority frames keyed on meta.src, and after 5 priority observations from her, drops further priority frame forwards silently with `rts_drop_originator_priority_throttle`. Path is alice → bob → carol; carol receives the first 5 priority deliveries, then bob stops forwarding from the 6th onward. Debug window 0-30000ms gives a full trace.",
  "simulation": {
    "duration_ms": 30000,
    "step_ms": 1,
    "warmup_ms": 0,
    "seed": 64,
    "node_startup_jitter_ms": 0,
    "radio": { "sf": 7, "bw": 250, "cr": 5 }
  },
  "nodes": [
    { "name": "alice", "node_id": 1, "key_hash32": "0xAAAAAAAA", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0,
        "originator_priority_max_per_window": 100,
        "debug_start_ms": 0, "debug_end_ms": 30000 } },
    { "name": "bob",   "node_id": 2, "key_hash32": "0xBBBBBBBB", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 30000 } },
    { "name": "carol", "node_id": 3, "key_hash32": "0xCCCCCCCC", "script": "scenarios/dv_dual_sf.lua",
      "config": { "layer_id": 1, "routing_sf": 7, "allowed_data_sfs": [7], "beacon_period_ms": 60000, "discovery_beacon_period_ms": 30000, "quiet_threshold_ms": 0,
        "debug_start_ms": 0, "debug_end_ms": 30000 } }
  ],
  "topology": {
    "links": [
      { "from": "alice", "to": "bob",   "snr": 22.0, "rssi": -68.0, "bidir": true },
      { "from": "bob",   "to": "carol", "snr": 22.0, "rssi": -68.0, "bidir": true }
    ]
  },
  "commands": [
    { "at_ms":  3000, "node": "alice", "command": "send_priority carol p1" },
    { "at_ms":  6000, "node": "alice", "command": "send_priority carol p2" },
    { "at_ms":  9000, "node": "alice", "command": "send_priority carol p3" },
    { "at_ms": 12000, "node": "alice", "command": "send_priority carol p4" },
    { "at_ms": 15000, "node": "alice", "command": "send_priority carol p5" },
    { "at_ms": 18000, "node": "alice", "command": "send_priority carol p6" },
    { "at_ms": 21000, "node": "alice", "command": "send_priority carol p7" }
  ],
  "expect": [
    { "type": "script_emit_contains", "node": "bob", "emit_type": "rts_drop_originator_priority_throttle", "value": "\"from\":1" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "rts_drop_originator_priority_throttle", "value": "\"apparent_origination\":5" },
    { "type": "script_emit_contains", "node": "bob", "emit_type": "rts_drop_originator_priority_throttle", "value": "\"cap\":5" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "delivered", "value": "p1" },
    { "type": "script_emit_contains", "node": "carol", "emit_type": "delivered", "value": "p5" }
  ]
}
